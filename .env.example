# Safe, non-secret configuration. Copy this file to .env for local development.
NODE_ENV=development
PORT=3000
BIND_HOST=127.0.0.1
LOCAL_DEV_NO_AUTH=1
TRUST_PROXY=0
DEFAULT_PROVIDER=deepseek

# Optional NVIDIA-hosted models require your own NVIDIA API key.
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it
# Optional comma-separated model IDs to add to the server allowlist.
# NVIDIA_MODELS=google/gemma-4-31b-it
DEEPSEEK_API_URL=https://api.deepseek.com/responses
DEEPSEEK_MODEL=deepseek-flash
# The default allowlist also includes deepseek-v4-pro.
# DEEPSEEK_MODELS=deepseek-v4-pro

# Optional official Google Gemini API provider. Its API quota/billing is
# separate from a Google AI Pro subscription.
GEMINI_MODEL=gemini-2.5-flash
# Official GenerateContent endpoint used only when Google Search is enabled.
GEMINI_SEARCH_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/
# The default allowlist also includes gemini-2.5-pro.
# GEMINI_MODELS=gemini-3.8-flash

# OpenRouter shows a curated group of free and paid high-capability models.
# Availability, labels and parameter support refresh at startup.
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_MODEL_CATALOG_URL=https://openrouter.ai/api/v1/models/user

# Optional OpenAI provider for a future OpenAI Project key.
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-5.6-terra
# OPENAI_MODELS=gpt-5.6-luna
# 0: no extra site-wide output-token ceiling; users choose per conversation.
MAX_OUTPUT_TOKENS=0
SYSTEM_PROMPT=You are a helpful assistant.

# Leave empty for same-origin requests. For a separately hosted frontend, use
# comma-separated exact origins, for example: https://www.example.com
ALLOWED_ORIGINS=

# Legacy gateway settings below are not a replacement for the signed-in
# website administrator policy. See docs/DEVELOPER_ADMIN.md.
RATE_LIMIT_PER_MINUTE=10
MAX_RATE_LIMIT_BUCKETS=2048
MAX_CONCURRENT_REQUESTS=2
DAILY_REQUEST_LIMIT=100
DAILY_TOKEN_LIMIT=200000
REQUEST_TIMEOUT_MS=90000
MAX_BODY_BYTES=65536
MAX_INPUT_CHARS=24000

# Optional server-side public conversation space. Everyone with the website
# access code can read published conversations; only the publisher can edit.
SHARED_CONVERSATIONS_FILE=./data/shared-conversations.json
# Account metadata defaults to accounts.json beside the shared conversation file.
# Back up both this file and the matching .workspaces directory. Single writer only.
# ACCOUNT_STORE_FILE=./data/accounts.json
# Optional local/cloud replication. Cloud servers leave this unset.
# SHARED_SYNC_URL=https://your-website.example
# SHARED_SYNC_TOKEN_FILE=./secrets/cloud_gateway_access_token


# Secret values belong in ignored files, not in this file.
NVIDIA_API_KEY_FILE=./secrets/nvidia_api_key
DEEPSEEK_API_KEY_FILE=./secrets/deepseek_api_key
# Create this file with your own Google AI Studio API key to enable Gemini.
# GEMINI_API_KEY_FILE=./secrets/gemini_api_key
OPENROUTER_API_KEY_FILE=./secrets/openrouter_api_key
# OPENAI_API_KEY_FILE=./secrets/openai_api_key
GATEWAY_ACCESS_TOKEN_FILE=./secrets/gateway_access_token

# Optional private isolated code runner (Linux server only)
# CODE_RUNNER_SOCKET=/run/plaude-runner/runner.sock
